## DESCRIPTION
## Linear Algebra
## Anton, Elementary Linear Algebra 10th edition
## Problem in Supplementary Exercises p.117
## ENDDESCRIPTION

## KEYWORDS('matrix','matrices')

## DBsubject('Linear Algebra')
## DBchapter('Determinants')
## DBsection('Computing determinants')
## Date('24 November 2011')
## Author('Charles Fortin')
## Institution('Champlain College')
## TitleText1('Elementary Linear Algebra')
## EditionText1('10')
## AuthorText1('Anton')
## Section1('Supplementary exercises p.117')
## Problem1('30')

DOCUMENT();

loadMacros(
    'PGstandard.pl',     'PGML.pl',
    'PG.pl',             'PGchoicemacros.pl',
    'PGmatrixmacros.pl', 'PGcourse.pl'
);

$showPartialCorrectAnswers = 1;

Context("Numeric");
Context()->variables->add(t => "Real");

$c  = random(2, 6);
$c2 = Compute("$c^2");
$a  = random(-$c2 - 6, -$c2 - 1);
$d  = Compute("-$c2-$a");           # should be >0

$ans2 = Compute("0");
$ans3 = Compute("0");

$det = Compute("t^2+$d");

BEGIN_PGML
Consider the system of equations
  
[```
\begin{array}{rcl}
[$c] x- t x + [$a] y &=& 0, \\
x - [$c] y - t y &=& 0.
\end{array}
```]
  
Find an expression for the determinant of the coefficient matrix [`A`] of this system.
  
>>
[`\text{det}(A)`] = [_]{$det}{5}
<<
  
Use your previous answer to give the solutions for [`x`] and [`y`] of this system for all real values of [`t`].
  
>>
[`x =`] [_]{$ans3}{5} and  [`y =`] [_]{$ans2}{5} and  [`y =`] 
<<

END_PGML

# ANS($det->cmp());
# ANS($ans2->cmp());
# ANS($ans3->cmp());

ENDDOCUMENT();
